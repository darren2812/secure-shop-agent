# Backend secrets live only in backend/.env (gitignored). Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
VOICE_MODEL=gpt-live-1.1
# Shared token the web app sends in X-Demo-Token to open voice sessions
DEMO_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173
# Leave empty to use local SQLite; set for SingleStore (mysql-compatible)
DATABASE_URL=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
SHOPSAVVY_API_KEY=

# Web (web/.env.local, gitignored): same value as DEMO_TOKEN above
# VITE_DEMO_TOKEN=
