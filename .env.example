# Backend secrets live only in backend/.env (gitignored). Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
VOICE_MODEL=gpt-live-1.1
# Shared token the web app sends in X-Demo-Token to open voice sessions
DEMO_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173
# Empty = SQLite. SingleStore: mysql://user:password@master-host:3306/shop_demo
# Use the master/DDL endpoint for transactional reference-table writes.
DATABASE_URL=
# Tests read this from the process environment only; _drill or _test suffix required.
# TEST_DATABASE_URL=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
SHOPSAVVY_API_KEY=

# Web (web/.env.local, gitignored): same value as DEMO_TOKEN above
# VITE_DEMO_TOKEN=
# Server-only key for the keyed audit chain (HMAC). Never rotate mid-demo: old receipts stop verifying.
AUDIT_HMAC_KEY=
